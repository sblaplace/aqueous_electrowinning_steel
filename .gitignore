# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
.conda/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Raw experimental exports are immutable and may be large or proprietary.
# Keep their paths/checksums in campaign manifests; commit only mapped, reviewed data.
experiments/data/raw/

# Evidence separation: synthetic fixtures, literature extracts, and processed
# outputs are tracked separately so models cannot silently train on their own
# fixtures. See experiments/data/README.md for the data-lifecycle contract.
experiments/data/synthetic/
experiments/data/literature/
experiments/data/processed/
experiments/data/calibrations/

# Large output data (keep structure, exclude bulky files)
*.h5
*.hdf5
*.pkl
*.pickle
!experiments/data/.gitkeep

# OS
.DS_Store
Thumbs.db

# COMSOL / simulation outputs
*.mph
*.m
!models/*.py

# Generated figures are tracked in git (small enough for GitHub)

# Numba JIT cache — excluded from git but MUST survive Arena snapshot wipes.
# Arena excludes __pycache__/ from snapshots, so numba's default cache location
# is lost every session.  We redirect it here via NUMBA_CACHE_DIR.
.numba_cache/

# Step cache manifest — content-addressable bookkeeping for run_all.
# Safe to delete; the next run rebuilds it from scratch.
experiments/data/.step_cache/

# Test artifacts
.pytest_cache/
.worktrees/
.benchmarks/
